{
  "manifest_version": 3,
  "name": "Orbit Agent",
  "version": "1.0.0",
  "description": "Browser agent managed by the Orbit Control Platform.",
  "permissions": [
    "storage",
    "alarms",
    "browsingData"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Orbit Agent"
  }
}